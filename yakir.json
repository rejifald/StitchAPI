{
    "ignore": ["CHANGELOG.md"],
    "tethers": [
        {
            "id": "release-version",
            "tier": "token",
            "fact": "the documented StitchAPI release version — package source vs. the READMEs that quote it",
            "policy": { "severity": "block", "mode": "auto" },
            "sites": [
                {
                    "artifact": "packages/core/package.json",
                    "locator": { "kind": "json-pointer", "path": "/version" },
                    "write": "manual"
                },
                {
                    "artifact": "README.md",
                    "locator": {
                        "kind": "pattern",
                        "match": "StitchAPI is at `([^`]+)`"
                    },
                    "write": "managed"
                },
                {
                    "artifact": "packages/core/README.md",
                    "locator": {
                        "kind": "pattern",
                        "match": "StitchAPI is at `([^`]+)`"
                    },
                    "write": "managed"
                }
            ]
        },
        {
            "id": "bundle-advertised-size",
            "tier": "executable",
            "fact": "every advertised gzip bundle size equals the measured one (whole entry + import { stitch })",
            "policy": { "severity": "block", "mode": "propose" },
            "origin": "declared",
            "sites": [
                {
                    "locator": {
                        "kind": "command",
                        "run": "node packages/core/scripts/bundle-size.mjs --json",
                        "extract": {
                            "regex": "\"kb\"\\s*:\\s*(\\d+)",
                            "all": true
                        }
                    },
                    "write": "manual"
                },
                {
                    "artifact": "README.md",
                    "locator": {
                        "kind": "pattern",
                        "match": "~(?:\\s|&nbsp;|%20)*(\\d+)(?:\\s|&nbsp;|%20)*kB",
                        "all": true
                    },
                    "write": "managed"
                },
                {
                    "artifact": "packages/core/README.md",
                    "locator": {
                        "kind": "pattern",
                        "match": "~(?:\\s|&nbsp;|%20)*(\\d+)(?:\\s|&nbsp;|%20)*kB",
                        "all": true,
                        "allow": [64, 20]
                    },
                    "write": "managed"
                },
                {
                    "artifact": "apps/docs/content/docs/getting-started/installation.mdx",
                    "locator": {
                        "kind": "pattern",
                        "match": "~(?:\\s|&nbsp;|%20)*(\\d+)(?:\\s|&nbsp;|%20)*kB",
                        "all": true
                    },
                    "write": "managed"
                },
                {
                    "artifact": "apps/docs/content/docs/concepts/principles.mdx",
                    "locator": {
                        "kind": "pattern",
                        "match": "~(?:\\s|&nbsp;|%20)*(\\d+)(?:\\s|&nbsp;|%20)*kB",
                        "all": true
                    },
                    "write": "managed"
                },
                {
                    "artifact": "apps/docs/app/(home)/components/metrics.tsx",
                    "locator": {
                        "kind": "pattern",
                        "match": "~(?:\\s|&nbsp;|%20)*(\\d+)(?:\\s|&nbsp;|%20)*kB",
                        "all": true
                    },
                    "write": "managed"
                }
            ]
        }
    ]
}
