{
    "name": "@stitchapi/workspace",
    "version": "0.0.0",
    "private": true,
    "description": "Workspace root for StitchAPI — the published library lives in packages/core.",
    "license": "Apache-2.0",
    "author": "Oleksandr Zhuravlov (rejifald@gmail.com)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rejifald/StitchAPI.git"
    },
    "packageManager": "pnpm@10.33.2",
    "scripts": {
        "build": "pnpm -r build",
        "test": "pnpm -r test",
        "test:coverage": "pnpm -r test:coverage",
        "check:types": "pnpm -r check:types",
        "check:types-d": "pnpm -r check:types-d",
        "check:lint": "node scripts/check-lint.mjs",
        "check:exports": "pnpm -r check:exports",
        "check:exports:companions": "node scripts/check-companion-exports.mjs",
        "check:size": "pnpm -r check:size",
        "check:docs-links": "node scripts/check-docs-links.mjs",
        "check:contract": "node scripts/check-contract.mjs",
        "check:unknown-keys": "node scripts/check-unknown-keys.mjs",
        "check:changelog": "node scripts/check-changelog.mjs",
        "check:format": "prettier --check .",
        "check:media-fresh": "node scripts/check-media-freshness.mjs",
        "check:release": "node scripts/check-release.mjs",
        "format": "prettier --write .",
        "gen:media": "node scripts/gen-demo.mjs",
        "gen:readme": "node scripts/gen-readme-metrics.mjs",
        "metrics": "mkdir -p .metrics && pnpm exec fallow --format json --score > .metrics/fallow.json && pnpm --filter stitchapi test:coverage && node scripts/gen-readme-metrics.mjs --refresh",
        "prepare": "lefthook install"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@vitest/eslint-plugin": "^1.6.27",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "fallow": "^3.22.0",
        "lefthook": "^2.1.12",
        "prettier": "3.9.6",
        "semver": "^7.8.5",
        "tsx": "^4.23.13",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.68.0"
    },
    "pnpm": {
        "overrides": {
            "postcss@<8.5.18": "^8.5.18",
            "esbuild@<0.28.1": ">=0.28.1",
            "dompurify@<3.4.12": "^3.4.12",
            "@hono/node-server@<2.0.5": "^2.0.5",
            "adm-zip@<0.6.0": "^0.6.0",
            "protobufjs@<7.6.5": "^7.6.5",
            "fast-uri@<3.1.5": "^3.1.5",
            "fast-uri@>=4.0.0 <4.1.2": "^4.1.2",
            "brace-expansion@<1.1.18": "^1.1.18",
            "brace-expansion@>=5.0.0 <5.0.9": "^5.0.9",
            "find-my-way@<9.7.0": "^9.7.0",
            "js-yaml@>=4.0.0 <4.3.0": "^4.3.0",
            "shell-quote@<1.9.0": "^1.9.0",
            "sharp@<0.35.0": "^0.35.3",
            "ip-address@<10.3.1": "^10.3.1",
            "xcode>uuid": "^11.1.1",
            "@codemirror/state": "^6.7.1"
        }
    }
}
