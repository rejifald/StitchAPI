{
    "name": "@stitchapi/workspace",
    "version": "0.0.0",
    "private": true,
    "description": "Workspace root for StitchAPI — the published library lives in packages/core.",
    "license": "Apache-2.0",
    "author": "Oleksandr Zhuravlov (rejifald@gmail.com)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rejifald/StitchAPI.git"
    },
    "packageManager": "pnpm@10.33.2",
    "scripts": {
        "build": "pnpm -r build",
        "test": "pnpm -r test",
        "test:coverage": "pnpm -r test:coverage",
        "check:types": "pnpm -r check:types",
        "check:types-d": "pnpm -r check:types-d",
        "check:lint": "pnpm -r check:lint",
        "check:exports": "pnpm -r check:exports",
        "check:exports:companions": "node scripts/check-companion-exports.mjs",
        "check:size": "pnpm -r check:size",
        "check:docs-links": "node scripts/check-docs-links.mjs",
        "check:contract": "node scripts/check-contract.mjs",
        "check:format": "prettier --check .",
        "check:media-fresh": "node scripts/check-media-freshness.mjs",
        "check:release": "node scripts/check-release.mjs",
        "format": "prettier --write .",
        "gen:media": "node scripts/gen-demo.mjs",
        "gen:readme": "node scripts/gen-readme-metrics.mjs",
        "metrics": "mkdir -p .metrics && pnpm exec fallow --format json --score > .metrics/fallow.json && pnpm --filter stitchapi test:coverage && node scripts/gen-readme-metrics.mjs --refresh",
        "prepare": "lefthook install"
    },
    "devDependencies": {
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "fallow": "^3.10.0",
        "lefthook": "^2.1.10",
        "prettier": "3.9.6",
        "semver": "^7.8.5",
        "tsx": "^4.23.1"
    },
    "pnpm": {
        "overrides": {
            "postcss@<8.5.18": "^8.5.18",
            "esbuild@<0.28.1": ">=0.28.1",
            "dompurify@<3.4.12": "^3.4.12",
            "@hono/node-server@<2.0.5": "^2.0.5",
            "adm-zip@<0.6.0": "^0.6.0",
            "protobufjs@<7.6.5": "^7.6.5",
            "fast-uri@<3.1.4": "^3.1.4"
        }
    }
}
