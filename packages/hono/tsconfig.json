{
    "compilerOptions": {
        // tsup injects `baseUrl` into every dts build (rollup.js: `baseUrl: compilerOptions.baseUrl
        // || "."`), and TS6 deprecates it — TS5101. Nothing here declares one (#738 removed them
        // all); this tolerates the one the bundler synthesises. Expires at TS7, which stops
        // honouring `baseUrl` outright — by then the dts step must move off tsup.
        "ignoreDeprecations": "6.0",
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "noEmit": true,

        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitOverride": true,
        "noPropertyAccessFromIndexSignature": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,

        "types": ["node", "vitest/globals"],

        // Resolve the workspace package to its SOURCE so typecheck + tests don't
        // depend on `stitchapi` being built first (the pre-push gate typechecks
        // before it builds). The published `exports` map still points at `lib/`.
        "paths": {
            "stitchapi/testing": ["../core/src/testing.ts"],
            "stitchapi/sse": ["../core/src/sse.ts"],
            "stitchapi/sse-emit": ["../core/src/sse-emit.ts"],
            "stitchapi": ["../core/src/index.ts"]
        }
    },
    "include": ["src/**/*.ts", "test/**/*.ts"]
}
