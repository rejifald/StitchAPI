{
    "name": "@stitchapi/fastify",
    "version": "1.0.0-rc.7",
    "type": "commonjs",
    "description": "Fastify plugin for StitchAPI — decorate the app/request with a seam, request-scoped principal (AsyncLocalStorage), and SSE + error + Pino-logger bridges.",
    "main": "lib/index.js",
    "module": "lib/index.mjs",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./lib/index.d.mts",
                "default": "./lib/index.mjs"
            },
            "require": {
                "types": "./lib/index.d.ts",
                "default": "./lib/index.js"
            }
        }
    },
    "sideEffects": false,
    "files": [
        "lib"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "check:types": "tsc --noEmit",
        "prepack": "tsup",
        "prepublishOnly": "node ../../scripts/check-release.mjs --changelog"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rejifald/StitchAPI.git",
        "directory": "packages/fastify"
    },
    "keywords": [
        "stitchapi",
        "fastify",
        "fastify-plugin",
        "seam",
        "principal",
        "multi-tenant",
        "sse",
        "pino",
        "typescript",
        "api-client",
        "rate-limiting"
    ],
    "author": "Oleksandr Zhuravlov (rejifald@gmail.com)",
    "license": "Apache-2.0",
    "homepage": "https://stitchapi.dev",
    "engines": {
        "node": ">=18.18.0"
    },
    "peerDependencies": {
        "stitchapi": "^1.0.0-rc.1",
        "fastify": "^4.0.0 || ^5.0.0"
    },
    "dependencies": {
        "fastify-plugin": "^6.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "fastify": "^5.12.3",
        "stitchapi": "workspace:*",
        "tsup": "^8.3.0",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11"
    }
}
