    "sideEffects": false,
    "bin": {
        "stitch": "bin/stitch"
    },
    "files": [
        "lib",
        "bin"
    ],
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:mcp-e2e": "vitest run test/mcp-e2e.spec.ts",
        "check:types": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
        "check:types-d": "tsup --silent && tsd",
        "check:lint": "eslint src test",
        "check:exports": "attw --pack . --ignore-rules no-resolution",
        "check:size": "node scripts/bundle-size.mjs",
        "size": "tsup --silent && node scripts/bundle-size.mjs",
        "lint": "eslint src test",
        "build": "tsup",
        "prepack": "tsup",
        "prepublishOnly": "node ../../scripts/check-release.mjs --changelog"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rejifald/StitchAPI.git",
        "directory": "packages/core"
    },
    "keywords": [
