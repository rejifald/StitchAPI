        "directory": "test-d",
        "compilerOptions": {
            "strict": true,
            "exactOptionalPropertyTypes": true,
            "noUncheckedIndexedAccess": true,
            "skipLibCheck": true,
            "target": "ES2022",
            "module": "ESNext",
            "moduleResolution": "bundler",
            "lib": [
                "ES2022",
                "DOM"
            ]
        }
