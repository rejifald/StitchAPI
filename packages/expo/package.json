{
    "name": "@stitchapi/expo",
    "version": "1.0.0-rc.7",
    "type": "commonjs",
    "description": "Expo bindings for StitchAPI — expoFetchAdapter (streaming over expo/fetch, no polyfills), an expo-secure-store-backed StitchStore for encrypted tokens, and the re-exported useStitch/useStitchStream hooks, AsyncStorage store, and AppState/NetInfo refetch helpers from @stitchapi/react-native.",
    "main": "lib/index.js",
    "module": "lib/index.mjs",
    "types": "lib/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./lib/index.d.mts",
                "default": "./lib/index.mjs"
            },
            "require": {
                "types": "./lib/index.d.ts",
                "default": "./lib/index.js"
            }
        }
    },
    "sideEffects": false,
    "files": [
        "lib"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "check:types": "tsc --noEmit",
        "prepack": "tsup",
        "prepublishOnly": "node ../../scripts/check-release.mjs --changelog"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rejifald/StitchAPI.git",
        "directory": "packages/expo"
    },
    "keywords": [
        "stitchapi",
        "expo",
        "react-native",
        "streaming",
        "sse",
        "expo-fetch",
        "secure-store",
        "hooks",
        "mobile",
        "typescript"
    ],
    "author": "Oleksandr Zhuravlov (rejifald@gmail.com)",
    "license": "Apache-2.0",
    "homepage": "https://stitchapi.dev",
    "engines": {
        "node": ">=18.18.0"
    },
    "peerDependencies": {
        "@stitchapi/query-core": "^1.0.0-rc.2",
        "@stitchapi/react": "^1.0.0-rc.2",
        "@stitchapi/react-native": "^1.0.0-rc.2",
        "stitchapi": "^1.0.0-rc.1",
        "react": "^18.0.0 || ^19.0.0",
        "react-native": ">=0.70.0",
        "expo": ">=51.0.0",
        "expo-secure-store": ">=13.0.0",
        "@react-native-async-storage/async-storage": "^1.0.0 || ^2.0.0",
        "@react-native-community/netinfo": ">=9.0.0"
    },
    "peerDependenciesMeta": {
        "expo-secure-store": {
            "optional": true
        },
        "@react-native-async-storage/async-storage": {
            "optional": true
        },
        "@react-native-community/netinfo": {
            "optional": true
        }
    },
    "devDependencies": {
        "@stitchapi/query-core": "workspace:*",
        "@stitchapi/react": "workspace:*",
        "@stitchapi/react-native": "workspace:*",
        "@types/node": "^26.4.1",
        "@types/react": "^19.2.18",
        "react": "^19.2.8",
        "stitchapi": "workspace:*",
        "tsup": "^8.3.0",
        "typescript": "^6.0.3",
        "vitest": "^5.0.0"
    }
}
