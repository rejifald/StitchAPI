{
    "name": "@stitchapi/docs",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "StitchAPI documentation site — Fumadocs (Next.js App Router). Content lands in follow-up PRs.",
    "scripts": {
        "dev": "pnpm run build:typed-deps && pnpm run build:sandbox && pnpm run build:media && next dev",
        "build": "pnpm run build:typed-deps && pnpm run build:sandbox && pnpm run build:media && node scripts/prebuild-search-index.mjs && NODE_OPTIONS=--max-old-space-size=3072 next build --webpack",
        "start": "next start",
        "check:types": "pnpm run build:typed-deps && next typegen && fumadocs-mdx && node scripts/check-generated-source.mjs && tsc --noEmit",
        "check:lint": "eslint .",
        "check:core-build": "node scripts/check-core-build.mjs",
        "check:build-memory": "node scripts/check-build-memory.mjs",
        "check:traces": "node scripts/check-traces.mjs",
        "check:function-size": "node scripts/check-function-size.mjs",
        "gen:docs": "node scripts/generate-skeleton.mjs",
        "gen:completions": "node scripts/gen-stitch-completions.mjs",
        "gen:cover": "node --import tsx/esm scripts/gen-cover.mjs",
        "build:core": "pnpm --filter stitchapi build",
        "build:typed-deps": "pnpm --filter stitchapi --filter @stitchapi/nest --filter @stitchapi/pino --filter @stitchapi/query-core --filter @stitchapi/react --filter @stitchapi/fastify --filter @stitchapi/hono build && node scripts/check-core-build.mjs",
        "build:media": "node scripts/copy-demo-media.mjs",
        "build:sandbox": "node scripts/gen-stitch-completions.mjs && node ../../docs/sandbox/runtime/gen-sandbox-modules.mjs && node ../../docs/sandbox/runtime/build-sandbox-worker.mjs",
        "build:search-index": "pnpm run build:typed-deps && fumadocs-mdx && node --import tsx/esm scripts/build-search-index.mjs",
        "build:docs-pages": "pnpm run build:typed-deps && fumadocs-mdx && node --import tsx/esm scripts/build-docs-pages.mjs",
        "build:mcp-bundle": "pnpm run build:search-index && node --import tsx/esm scripts/build-docs-pages.mjs",
        "check:search-relevance": "pnpm run build:search-index && node --import tsx scripts/search-eval.mts --assert",
        "fetch:embed-model": "node --import tsx/esm scripts/fetch-embed-model.mts",
        "embed-model-cache-key": "node --import tsx/esm scripts/embed-model-cache-key.mts",
        "smoke:mcp": "node --import tsx scripts/smoke-mcp.mts",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "test:e2e:install": "playwright install chromium"
    },
    "dependencies": {
        "@codemirror/autocomplete": "^6.20.4",
        "@codemirror/lang-javascript": "^6.2.2",
        "@codemirror/language": "^6.13.1",
        "@lezer/highlight": "^1.2.5",
        "@modelcontextprotocol/server": "^2.3.1",
        "@stitchapi/sandbox": "workspace:*",
        "@uiw/react-codemirror": "^4.25.12",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0",
        "fumadocs-core": "^16.17.8",
        "fumadocs-mdx": "^15.4.10",
        "fumadocs-twoslash": "^4.0.2",
        "fumadocs-typescript": "^5.6.0",
        "fumadocs-ui": "^16.17.8",
        "lucide-react": "^1.61.0",
        "mcp-handler": "^2.3.0",
        "next": "16.4.3",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "stitchapi": "workspace:*",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@huggingface/transformers": "^4.3.2",
        "@nestjs/common": "^12.4.0",
        "@nestjs/config": "^12.1.1",
        "@nestjs/core": "^12.4.0",
        "@orama/orama": "3.1.18",
        "@orama/plugin-data-persistence": "3.1.18",
        "@playwright/test": "^1.65.0",
        "@stitchapi/completions-plugin": "workspace:*",
        "@stitchapi/fastify": "workspace:*",
        "@stitchapi/hono": "workspace:*",
        "@stitchapi/nest": "workspace:*",
        "@stitchapi/pino": "workspace:*",
        "@stitchapi/query-core": "workspace:*",
        "@stitchapi/react": "workspace:*",
        "@tailwindcss/postcss": "^4.3.5",
        "@tanstack/react-query": "^5.106.1",
        "@types/mdx": "^2.0.13",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.14.0",
        "eslint-config-next": "16.4.5",
        "fastify": "^5.12.6",
        "hono": "^4.13.16",
        "pino": "^10.4.0",
        "postcss": "^8.5.32",
        "reflect-metadata": "^0.2.2",
        "shiki": "4.6.0",
        "tailwindcss": "^4.3.5",
        "tsx": "^4.23.15",
        "twoslash": "^0.3.9",
        "typescript": "^6.0.3",
        "vitest": "^5.1.0"
    }
}
